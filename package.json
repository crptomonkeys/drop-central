{
  "name": "cm-drops-api",
  "version": "0.0.1",
  "description": "service to drop nfts to the cryptomonkeys community",
  "author": "green",
  "type": "module",
  "license": "MIT",
  "private": true,
  "scripts": {
    "lint": "eslint src/**/*.ts* --fix",
    "prettier": "prettier ./**/*.ts* --config .prettierrc.json --write",
    "dev": "tsx src/api.ts",
    "build": "tsc && mkdir -p dist/templates && cp src/templates/* dist/templates/",
    "start": "node dist/api.js",
    "wipe": "tsx src/util/db-wipe.ts",
    "type-check": "tsc",
    "test": "mocha 'test/**/*.ts'"
  },
  "dependencies": {
    "@emotion/react": "^11.11.4",
    "@emotion/styled": "^11.11.5",
    "@mui/material": "^5.15.19",
    "@wharfkit/session": "^1.3.1",
    "@wharfkit/wallet-plugin-privatekey": "^1.1.0",
    "axios": "^1.7.2",
    "express": "4.19.2",
    "node-fetch": "3.3.2",
    "pg": "^8.11.5",
    "reflect-metadata": "0.2.2",
    "swagger-ui-express": "^5.0.1",
    "typeorm": "0.3.20",
    "yamljs": "^0.3.0"
  },
  "devDependencies": {
    "@types/chai": "^4.3.19",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.13",
    "@types/mocha": "^10.0.8",
    "@types/pg": "^8.11.6",
    "@types/sinon": "^17.0.3",
    "@types/supertest": "6.0.2",
    "@types/swagger-ui-express": "^4.1.6",
    "@types/yamljs": "^0.2.34",
    "chai": "^5.1.1",
    "mocha": "^10.7.3",
    "sinon": "^19.0.2",
    "supertest": "^7.0.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.10.5",
    "typescript": "^4.9.5"
  },
  "browser": {
    "fs": false,
    "path": false,
    "os": false
  }
}
